{
  "manifest_version": 3,
  "name": "SpireVault Sync",
  "short_name": "SpireVault Sync",
  "version": "0.1.0",
  "description": "New Slay the Spire 2 runs show up in SpireVault by themselves. Reads your save folder; never changes it.",
  "homepage_url": "https://app.spirevault.app/",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SpireVault Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "file:///*",
    "https://app.spirevault.app/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.spirevault.app/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
