# SpireVault Discord LFG Bridge — local env template.
# Copy to .env.local (gitignored) and fill in real values.

# From the Discord Developer Portal → your app → General Information.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# From the Discord Developer Portal → your app → Bot → Reset Token.
# Treat this as a secret — full access to the bot user.
DISCORD_BOT_TOKEN=

# Guild id for guild-scoped command registration during dev. Right-click
# any server icon in Discord (with Developer Mode enabled) → Copy ID.
# Leave blank to register commands globally.
DISCORD_GUILD_ID=

# Worker base URL. Defaults to the production worker if unset.
API_BASE=https://vault-coop.coreycrooks.workers.dev
