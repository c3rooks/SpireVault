<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>The Vault</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.6</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.coreycrooks.thevault.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>thevault</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>15</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>steam</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!--
		Force single-instance launch. Without this, macOS Launch Services
		can spawn a second copy of The Vault when a `thevault://` deep
		link is delivered to a different installed copy of the app
		(e.g. /Applications/The Vault.app vs ~/Desktop/The Vault.app).
		The user's most recent bug report was exactly this: clicking
		"Sign in with Steam" caused the OS to deliver the OpenID return
		URL to a *second* copy of the app, leaving them with two
		desktop windows side by side.

		`LSMultipleInstancesProhibited = true` means: if a relaunch is
		requested, bring the running instance forward instead of
		spawning a new one.
	-->
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Corey Crooks</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
