/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://avatars.steamstatic.com https://steamcdn-a.akamaihd.net https://*.steamstatic.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; font-src https://fonts.gstatic.com; connect-src 'self' https://vault-coop.coreycrooks.workers.dev https://cloudflareinsights.com https://api.openai.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# Strict no-cache for HTML and entry bundle.
#
# Earlier we used `max-age=0, must-revalidate`, but the live response was
# coming back with `max-age=14400` (4 hours) because Cloudflare Pages was
# applying its default rule and ignoring our overrides — possibly due to
# rule precedence under wildcard matching. Result: users in normal browser
# windows kept seeing old UI for 4 hours after every deploy, while Private
# windows (no disk cache) saw the new build immediately. That's the exact
# "incognito works, normal doesn't" symptom we kept chasing.
#
# The fix: use `no-store` (strictly stronger than `max-age=0`) PLUS an
# `Expires: 0` header for older HTTP caches that don't honor Cache-Control
# semantics. This guarantees:
#   - Browsers never serve a stale entry-point bundle from disk cache
#   - CDN/proxy nodes always go to origin
#   - bfcache (Safari/Chrome) is invalidated on every load
#
# Asset files under /assets/* keep `immutable, max-age=1y` because their
# URLs include version tokens (architect-wiki.webp, etc.). When we rev
# an asset, the URL changes and the cache is bypassed naturally.
# =============================================================================

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Expires: 0
  Pragma: no-cache

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Expires: 0
  Pragma: no-cache

/overlay
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Expires: 0
  Pragma: no-cache

/auth.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Expires: 0
  Pragma: no-cache

# =============================================================================
# Versioned code: cache hard.
#
# `no-store` used to extend to script.js, styles.css and all of /lib/*. That
# was the correct panic response to the 4-hour-stale-UI incident above, but it
# was aimed at the wrong layer and it never came back off. The stale UI came
# from the HTML entry point being cached; the code files it pulls in have
# ALWAYS been version-pinned (`/script.js?v=N`, `/lib/party-finder.js?v=N`,
# and so on), and a version-pinned URL cannot go stale — bumping the token
# produces a different URL, which is a different cache entry.
#
# So `no-store` on these bought nothing and cost a full re-download of roughly
# 1.5 MB of JavaScript on every single page load, for every user, forever.
# That is worst for exactly the people we most want to keep: the returning
# ones. The entry points above stay `no-store`, which is what actually
# guarantees a deploy is picked up — a fresh index.html carries the new
# version tokens, and those pull the new code.
#
# THE ONE RULE THIS DEPENDS ON: every reference to a file under these paths
# must carry a `?v=` token, and the token must be bumped whenever the file
# changes. A missed bump now means a user is pinned to the old file for a
# year, not four hours. `npm run check:asset-versions` enforces the first half
# of that rule; the second half is on the author.
# =============================================================================

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

/run-coach.js
  Cache-Control: public, max-age=31536000, immutable

/lib/*
  Cache-Control: public, max-age=31536000, immutable
